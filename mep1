        </div>
        <div id="sleep-active-state" class="hidden">
            <div class="sleep-option full" style="display:flex;align-items:center;justify-content:center;gap:6px;cursor:default;background:rgba(235,87,87,0.05);color:var(--accent);">
                <span class="sleep-dot"></span>
                <span id="sleep-popover-countdown">00:00</span>
