                <svg class="w-4 h-4 md:w-5 md:h-5 hidden pause-icon transition-transform group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"></path></svg>
            </button>
            <button onclick="nextStation()" aria-label="Next station" class="playlist-glass playlist-next-btn w-8 h-8 md:w-9 md:h-9 rounded-full flex items-center justify-center transition-all duration-300 active:scale-90"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6zm9-12v12h2V6z"></path></svg></button>
        </div>

        <!-- Desktop Only Actions -->
        <div class="hidden md:flex items-center justify-end gap-6 w-[30rem]">
            <div class="flex items-center gap-3 group">
                <svg class="w-4 h-4 text-[var(--text-muted)] group-hover:text-[var(--accent)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" stroke-width="2"></path></svg>
                <input type="range" id="volume-slider" min="0" max="1" step="0.01" value="0.7" aria-label="Volume" class="w-24 accent-[var(--accent)] h-1 rounded-lg cursor-pointer bg-white/10 appearance-none">
            </div>
            <button id="main-heart" onclick="toggleFavorite(event)" aria-label="Add to favourites" class="text-[var(--text-muted)] hover:text-[var(--accent)] transition-all transform active:scale-125">
                 <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" stroke-width="2.5"></path></svg>
