    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme');
            const isLight = savedTheme === 'light';
            const logo = document.getElementById('app-logo');
            if(isLight) {
                document.body.classList.add('light-mode');
                if(logo) logo.src = '/web/logo-black.png';
            } else {
                if(logo) logo.src = '/web/logo-white.png';
            }
        })();

        function toggleTheme() {
            const isLight = document.body.classList.toggle('light-mode');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            const logo = document.getElementById('app-logo');
            if(logo) logo.src = isLight ? '/web/logo-black.png' : '/web/logo-white.png';
        }

        window.addEventListener('scroll', () => {
            const header = document.getElementById('nav-header');
            if (window.scrollY > 20) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        function escHtml(str) {
            var d = document.createElement('div');
            d.appendChild(document.createTextNode(str));
            return d.innerHTML;
        }

        /* Server-rendered cards ship the logo as data-* instead of a src, so the
           proxy → remote → first letter → nRadioBox logo chain lives in exactly
           one place (NRBPlayer.logo.bind) for both the initial render and the
           search results built by createStationCard() below. */
        function bindStationLogos(root) {
            (root || document).querySelectorAll('[data-station-logo]').forEach(function (host) {
                if (host.dataset.logoBound === '1') return;
                host.dataset.logoBound = '1';
                NRBPlayer.logo.bind(
                    host.querySelector('img'),
                    host.querySelector('.station-logo-placeholder'),
                    { stationuuid: host.dataset.id, favicon: host.dataset.remote, name: host.dataset.name }
                );
            });
        }
        bindStationLogos();

        function createStationCard(s) {
            var a = document.createElement('a');
            a.href = s.path;
            a.className = 'station-card group';
            a.innerHTML = '<div class="station-logo" data-station-logo data-id="' + escHtml(s.id || '') + '" data-remote="' + escHtml(s.logoUrl || '') + '" data-name="' + escHtml(s.name) + '">'
                + '<img alt="" loading="lazy">'
                + '<div class="station-logo-placeholder">' + escHtml(s.initial) + '</div></div>'
                + '<div class="station-info"><div class="station-name">' + escHtml(s.name) + '</div>'
                + (s.tags ? '<div class="station-tags">' + escHtml(s.tags) + '</div>' : '') + '</div>'
                + (s.quality ? '<span class="station-badge">' + escHtml(s.quality) + '</span>' : '')
                + '<span class="station-arrow"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="2.5"/></svg></span>';
            bindStationLogos(a);
            return a;
        }

        // ── Search ──
        var searchInput = document.getElementById('station-search');
        var stationList = document.getElementById('station-list');
        var searchMatchEl = document.getElementById('search-match-count');
        var stationCountBar = document.querySelector('.station-count-bar');
        var paginationBar = document.querySelector('.flex.items-center.justify-center.gap-2.mt-8');
        var originalStationHtml = stationList ? stationList.innerHTML : '';
        var searchTimeout;

        function clearSearch() {
            var input = document.getElementById('station-search');
            if (input) {
                input.value = '';
                if (stationList) stationList.innerHTML = originalStationHtml;
                if (stationCountBar) stationCountBar.style.display = '';
                if (paginationBar) paginationBar.style.display = '';
                if (searchMatchEl) searchMatchEl.style.display = 'none';
                var clearBtn = document.getElementById('search-clear');
                if (clearBtn) clearBtn.style.display = 'none';
                input.focus();
            }
        }

        if (searchInput && stationList) {
            var clearBtn = document.getElementById('search-clear');

            searchInput.addEventListener('input', function() {
                var q = this.value.trim().toLowerCase();
                clearTimeout(searchTimeout);

                if (q === '') {
                    if (stationList) stationList.innerHTML = originalStationHtml;
                    if (stationCountBar) stationCountBar.style.display = '';
                    if (paginationBar) paginationBar.style.display = '';
                    if (searchMatchEl) searchMatchEl.style.display = 'none';
                    clearBtn.style.display = 'none';
                    return;
                }

                clearBtn.style.display = 'block';

                searchTimeout = setTimeout(function() {
                    if (stationCountBar) stationCountBar.style.display = 'none';
                    if (paginationBar) paginationBar.style.display = 'none';
                    if (searchMatchEl) {
                        searchMatchEl.style.display = 'inline';
                        searchMatchEl.textContent = 'Searching...';
                    }

                    fetch('/country/zwe/stations?q=' + encodeURIComponent(q))
                        .then(function(r) { return r.json(); })
                        .then(function(data) {
                            stationList.innerHTML = '';
                            if (data.length === 0) {
                                stationList.innerHTML = '<div class="no-stations glass-card rounded-lg p-12">No stations match your search.</div>';
                                if (searchMatchEl) searchMatchEl.textContent = '0 matched';
                            } else {
                                data.forEach(function(s) {
                                    stationList.appendChild(createStationCard(s));
                                });
                                if (searchMatchEl) searchMatchEl.textContent = data.length + ' matched';
                            }
                        })
                        .catch(function() {
                            if (searchMatchEl) searchMatchEl.textContent = 'Search failed';
                        });
                }, 300);
            });
        }
    </script>
    <!-- Shared global player (same bar on every page) -->
    

    
