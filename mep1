            </div>
            <!-- Mobile More Button -->
            <div class="flex md:hidden items-center">
                <button onclick="toggleMobilePlayerMenu(event)" aria-label="More player options" class="w-8 h-8 flex items-center justify-center text-[var(--text-muted)] hover:text-white transition-all">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" stroke-width="2"></path></svg>
                </button>
