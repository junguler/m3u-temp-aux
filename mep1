    <style>
        :root {
            --accent: #eb5757;
            --bg-dark: #0f1012;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
            --text-main: #ffffff;
            --text-muted: #949ba4;
        }
        body.light-mode {
            --bg-dark: #f8fafc;
            --glass: rgba(255, 255, 255, 0.7);
            --glass-border: rgba(0, 0, 0, 0.05);
            --text-main: #0f172a;
            --text-muted: #64748b;
        }
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
            transition: background-color 0.4s ease;
        }
        .bg-glow {
            position: fixed; top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 100vw; height: 100vw;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.03) 0%, rgba(0, 0, 0, 0) 70%);
            z-index: -1; pointer-events: none;
        }
        body.light-mode .bg-glow {
            background: radial-gradient(circle, rgba(15, 23, 42, 0.03) 0%, rgba(0, 0, 0, 0) 70%);
        }
        .glass-card {
            background: var(--glass);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid var(--glass-border);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
        }
        body.light-mode .glass-card {
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.05);
        }
        #nav-header {
            position: fixed; top: 0; left: 0; right: 0; height: 80px;
            display: flex; align-items: center; justify-content: center;
            z-index: 100; padding: 0 2rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border-bottom: 1px solid transparent;
        }
        #nav-header.scrolled {
            height: 64px;
            background: rgba(15, 16, 18, 0.85);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            pointer-events: auto !important;
        }
        body.light-mode #nav-header.scrolled {
            background: rgba(248, 250, 252, 0.85);
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            box-shadow: 0 10px 30px rgba(0,0,0,0.02);
        }
        .station-card {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 16px 20px;
            background: rgba(255,255,255,0.02);
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            text-decoration: none;
            transition: all 0.25s ease;
        }
        .station-card:hover {
            background: rgba(255,255,255,0.05);
            border-color: rgba(235,87,87,0.3);
            transform: translateY(-1px);
        }
        body.light-mode .station-card {
            background: rgba(0,0,0,0.02);
        }
        body.light-mode .station-card:hover {
            background: rgba(0,0,0,0.04);
        }
        .station-logo {
            width: 56px; height: 56px;
            border-radius: 8px;
            background: rgba(255,255,255,0.04);
            border: 1px solid var(--glass-border);
            overflow: hidden;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .station-logo img { width: 100%; height: 100%; object-fit: contain; }
        .station-logo-placeholder {
            font-size: 20px; font-weight: 500;
            color: var(--accent); text-transform: uppercase;
        }
        .station-info { flex: 1; min-width: 0; }
        .station-name { font-size: 15px; font-weight: 500; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .station-tags { font-size: 11px; font-weight: 500; color: var(--text-muted); margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .station-badge {
            padding: 4px 10px;
            background: rgba(235,87,87,0.1);
            border: 1px solid rgba(235,87,87,0.2);
            border-radius: 8px;
            font-size: 10px; font-weight: 500;
            color: var(--accent);
            flex-shrink: 0;
            letter-spacing: 0.05em;
            font-family: monospace;
        }
        .station-arrow {
            color: var(--text-muted);
            font-size: 14px;
            opacity: 0;
            transform: translateX(-4px);
            transition: all 0.25s ease;
            flex-shrink: 0;
        }
        .station-card:hover .station-arrow { opacity: 1; transform: translateX(0); }
        .no-stations {
            text-align: center; padding: 60px 20px;
            color: var(--text-muted); font-weight: 500; font-size: 15px;
        }
        .theme-toggle {
            width: 36px; height: 36px; border-radius: 8px;
            background: rgba(255,255,255,0.05);
            border: 1px solid var(--glass-border);
            color: var(--text-muted);
            display: flex; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.2s; pointer-events: auto;
        }
        .theme-toggle:hover { color: var(--text-main); border-color: rgba(255,255,255,0.15); }
        .theme-toggle svg { width: 17px; height: 17px; }
        .search-wrap { position: relative; margin-bottom: 20px; }
        .search-wrap input {
            width: 100%; padding: 14px 18px 14px 48px;
            background: rgba(255,255,255,0.03);
            border: 1px solid var(--glass-border);
            border-radius: 8px; color: var(--text-main);
            font-size: 14px; font-weight: 500; outline: none;
            transition: all 0.25s ease; font-family: inherit;
        }
        .search-wrap input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(235,87,87,0.15); }
        .search-wrap input::placeholder { color: var(--text-muted); opacity: 0.6; }
        body.light-mode .search-wrap input { background: rgba(0,0,0,0.02); }
        .search-icon {
            position: absolute; left: 16px; top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted); font-size: 16px;
            pointer-events: none; opacity: 0.5;
        }

        .station-count-bar {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 16px; font-size: 12px; font-weight: 500;
            color: var(--text-muted);
        }
        .station-count-bar strong { color: var(--accent); font-weight: 500; }
        .search-clear {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            background: none; border: none;
            color: var(--text-muted); cursor: pointer;
            padding: 6px; display: none;
            font-size: 14px; border-radius: 50%;
            transition: all 0.2s;
        }
        .search-clear:hover { color: var(--text-main); background: rgba(255,255,255,0.07); }
        body.light-mode .search-clear:hover { background: rgba(0,0,0,0.05); }
        @media (max-width: 640px) {
            .station-card { padding: 12px 14px; gap: 12px; }
            .station-logo { width: 44px; height: 44px; border-radius: 8px; }
            .station-name { font-size: 13px; }
            .station-badge { font-size: 9px; padding: 3px 8px; }
        }
    </style>
