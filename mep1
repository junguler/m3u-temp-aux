                    <span class="text-[10px] md:text-[11px] font-black text-[var(--accent)] uppercase tracking-[0.1em] truncate" id="player-now-playing"></span>
                </div>
                <div class="flex items-center gap-2 text-[8px] md:text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest">
